#!/usr/bin/env python3
import argparse
import time
from pathlib import Path

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image


SUPPORTED_ENCODINGS = {"rgb8", "bgr8", "mono8"}


def _stamp_seconds(msg):
    return float(msg.header.stamp.sec) + float(msg.header.stamp.nanosec) * 1e-9


def _write_image(path, msg):
    if msg.encoding not in SUPPORTED_ENCODINGS:
        raise ValueError(f"unsupported encoding: {msg.encoding}")

    width = int(msg.width)
    height = int(msg.height)
    channels = 1 if msg.encoding == "mono8" else 3
    expected_step = width * channels
    if int(msg.step) < expected_step:
        raise ValueError(f"invalid image step: {msg.step}, expected at least {expected_step}")

    data = memoryview(msg.data)
    rows = []
    for row in range(height):
        start = row * int(msg.step)
        raw = bytes(data[start:start + expected_step])
        if msg.encoding == "bgr8":
            converted = bytearray(len(raw))
            converted[0::3] = raw[2::3]
            converted[1::3] = raw[1::3]
            converted[2::3] = raw[0::3]
            raw = bytes(converted)
        rows.append(raw)

    path.parent.mkdir(parents=True, exist_ok=True)
    magic = "P5" if msg.encoding == "mono8" else "P6"
    with path.open("wb") as f:
        f.write(f"{magic}\n{width} {height}\n255\n".encode("ascii"))
        for row in rows:
            f.write(row)


class ImageSampler(Node):
    def __init__(self, args):
        super().__init__("carm_a3_image_sampler")
        self.args = args
        self.received = 0
        self.saved = 0
        self.first_wall_time = None
        self.last_wall_time = None
        self.first_stamp = None
        self.last_stamp = None
        self.last_msg = None
        self.subscription = self.create_subscription(Image, args.topic, self._on_image, 10)

    def _on_image(self, msg):
        now = time.monotonic()
        stamp = _stamp_seconds(msg)
        if self.received == 0:
            self.first_wall_time = now
            self.first_stamp = stamp
        self.received += 1
        self.last_wall_time = now
        self.last_stamp = stamp
        self.last_msg = msg

        if self.args.save_every > 0 and self.received % self.args.save_every == 0:
            self._save(msg)

    def _save(self, msg):
        suffix = "pgm" if msg.encoding == "mono8" else "ppm"
        path = Path(self.args.output_dir) / f"{self.args.prefix}_{self.received:04d}.{suffix}"
        _write_image(path, msg)
        self.saved += 1

    def save_last_if_needed(self):
        if self.last_msg is not None and self.saved == 0:
            self._save(self.last_msg)

    def summary(self):
        if self.received == 0:
            return {
                "frames": 0,
                "saved": 0,
                "wall_fps": 0.0,
                "stamp_fps": 0.0,
                "width": 0,
                "height": 0,
                "encoding": "",
            }

        wall_elapsed = max(0.0, self.last_wall_time - self.first_wall_time)
        stamp_elapsed = max(0.0, self.last_stamp - self.first_stamp)
        denominator = max(1, self.received - 1)
        wall_fps = denominator / wall_elapsed if wall_elapsed > 0.0 else 0.0
        stamp_fps = denominator / stamp_elapsed if stamp_elapsed > 0.0 else 0.0
        return {
            "frames": self.received,
            "saved": self.saved,
            "wall_fps": wall_fps,
            "stamp_fps": stamp_fps,
            "width": int(self.last_msg.width),
            "height": int(self.last_msg.height),
            "encoding": self.last_msg.encoding,
        }


def main():
    parser = argparse.ArgumentParser(description="Capture a short ROS image sample without OpenCV.")
    parser.add_argument("--topic", default="/carm_a3/camera/image_raw")
    parser.add_argument("--output-dir", default="/workspace/rl_ws/artifacts/camera_samples")
    parser.add_argument("--prefix", default="carm_a3_camera")
    parser.add_argument("--count", type=int, default=30)
    parser.add_argument("--timeout", type=float, default=5.0)
    parser.add_argument("--save-every", type=int, default=30, help="Save every Nth frame. 0 disables saving.")
    args = parser.parse_args()

    rclpy.init()
    sampler = ImageSampler(args)
    deadline = time.monotonic() + max(0.1, args.timeout)

    try:
        while rclpy.ok() and time.monotonic() < deadline:
            rclpy.spin_once(sampler, timeout_sec=0.1)
            if sampler.received >= args.count:
                break
        sampler.save_last_if_needed()
    finally:
        result = sampler.summary()
        sampler.destroy_node()
        rclpy.shutdown()

    print(f"topic={args.topic}")
    print(f"frames={result['frames']}")
    print(f"saved={result['saved']}")
    print(f"width={result['width']}")
    print(f"height={result['height']}")
    print(f"encoding={result['encoding']}")
    print(f"wall_fps={result['wall_fps']:.2f}")
    print(f"stamp_fps={result['stamp_fps']:.2f}")
    print(f"output_dir={Path(args.output_dir)}")
    if result["frames"] == 0:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
